      "--landscape-y",
      "--paused-file",
      "--portrait-cmd-file",
      "--portrait-height",
      "--portrait-hud-file",
      "--portrait-playlist",
      "--portrait-status-file",
      "--portrait-width",
      "--portrait-x",
      "--portrait-y",
      "--status-file",
      "--taskbar-identity",
      "--width",
      "--x",
      "--y"
    ],
    "in a headset": [
      "--command-file",
      "--dashboard-cmd-file",
      "--frames-file",
      "--fun-time",
      "--height",
      "--input-file",
      "--landscape-cmd-file",
      "--landscape-height",
