  "handoff": {
    "offer": {
      "file": "fun_time_offer.txt",
      "reads": {
        "pattern": "(\\d+) (\\d+)(?: (starting))?"
      }
    },
    "showing": {
      "file": "fun_time_showing.txt",
      "reads": {
        "pattern": "(\\d+) (\\d+)"
      }
    },
    "session": {
      "file": "fun_time_session.txt",
      "writes": [
        "4141 4242"
      ]
    },
    "takeover": {
      "file": "fun_time_takeover.json",
      "writes": [
        "{\"pid\": 4343, \"args\": [\"--fun-time\", \"--x\", \"0\", \"--y\", \"0\", \"--width\", \"10\", \"--height\", \"10\", \"--portrait-x\", \"0\", \"--portrait-y\", \"0\", \"--portrait-width\", \"10\", \"--portrait-height\", \"10\", \"--landscape-x\", \"0\", \"--landscape-y\", \"0\", \"--landscape-width\", \"10\", \"--landscape-height\", \"10\", \"--portrait-playlist\", \"C:\\\\a room\\\\state\\\\portrait_playlist.tsv\", \"--portrait-cmd-file\", \"C:\\\\a room\\\\state\\\\portrait_cmd.txt\", \"--portrait-status-file\", \"C:\\\\a room\\\\state\\\\portrait_status.txt\", \"--portrait-hud-file\", \"C:\\\\a room\\\\state\\\\origenerator_portrait_hud.json\", \"--landscape-playlist\", \"C:\\\\a room\\\\state\\\\landscape_playlist.tsv\", \"--landscape-cmd-file\", \"C:\\\\a room\\\\state\\\\landscape_cmd.txt\", \"--landscape-status-file\", \"C:\\\\a room\\\\state\\\\landscape_status.txt\", \"--landscape-hud-file\", \"C:\\\\a room\\\\state\\\\origenerator_landscape_hud.json\", \"--taskbar-identity\", \"FunTime.App\", \"--command-file\", \"C:\\\\a room\\\\state\\\\origenerator_cmd.txt\", \"--paused-file\", \"C:\\\\a room\\\\state\\\\origenerator_paused.txt\", \"--status-file\", \"C:\\\\a room\\\\state\\\\origenerator_status.txt\", \"--dashboard-cmd-file\", \"C:\\\\a room\\\\state\\\\dashboard_cmd.txt\"]}"
      ]
    }
  }
}
