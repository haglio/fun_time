      "--portrait-status-file",
      "--portrait-width",
      "--portrait-x",
      "--portrait-y",
      "--status-file",
      "--taskbar-identity",
      "--width",
      "--x",
      "--y"
    ]
  },
  "headset_words": [
    "drag",
    "hover",
    "press",
    "release",
    "rightclick",
    "scroll"
  ],
  "command_lines": [
    "CLOSE_SLIDESHOWS",
    "GO_TO|{file}",
    "HAND_OVER|{frames}|{input}",
    "LANDSCAPE_SAY:clear filter",
    "LANDSCAPE_SAY:enhanced only",
    "LANDSCAPE_SAY:experiments",
    "LANDSCAPE_SAY:favorites",
    "LANDSCAPE_SAY:filter enhanced",
