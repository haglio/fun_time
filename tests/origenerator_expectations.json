      "--dashboard-cmd-file",
      "--fun-time",
      "--height",
      "--landscape-cmd-file",
      "--landscape-height",
      "--landscape-hud-file",
      "--landscape-playlist",
      "--landscape-status-file",
      "--landscape-width",
