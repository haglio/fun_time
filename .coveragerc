[run]
source =
    .
omit =
    # the repo's own tests
    tests/*
    # names that quiet the dead-code scan, not code that runs
    vulture_whitelist.py
    # reaches a real Chrome's tabs: needs a browser
    fun_time/chrome_accessibility.py
    # listens to the presses and carets of a real desktop
    fun_time/win32_events.py
    # needs a graphics context
    fun_time_vr/gl_contexts.py
    # needs a graphics context
    fun_time_vr/render.py
    # the headset's shell: needs a headset
    fun_time_vr/app.py
    # needs a headset and a graphics context
    fun_time_vr/vr_session.py
    # sets Windows' default sound devices: a test would change the machine's
    fun_time_vr/windows_sound.py
relative_files = true

[report]
precision = 2
fail_under = 96.5
exclude_also =
    if TYPE_CHECKING:
    if __name__ == "__main__":
